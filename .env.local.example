# ============================================================
# DATABASE
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/railexchange?retryWrites=true&w=majority

# ============================================================
# AWS S3 (File Storage)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=railexchange-uploads

# ============================================================
# AUTHENTICATION
# ============================================================
# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# JWT for custom auth flows
JWT_SECRET=generate-with-openssl-rand-base64-32

# ============================================================
# SITE CONFIGURATION
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================================
# STRIPE PAYMENTS & SUBSCRIPTIONS
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Subscription Plans
STRIPE_PRICE_BASIC=price_basic_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_PREMIUM=price_premium_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
STRIPE_PRICE_CONTRACTOR_PRO=price_contractor_monthly

# Add-ons & Boosts
NEXT_PUBLIC_STRIPE_BOOST_PRICE_ID=price_featured_listing
STRIPE_PRICE_HOMEPAGE_BANNER=price_homepage_banner
STRIPE_PRICE_CATEGORY_SPONSOR=price_category_sponsor
STRIPE_PRICE_RENTAL_FLEET=price_rental_fleet_upgrade

# ============================================================
# EMAIL - RESEND
# ============================================================
RESEND_API_KEY=re_...
FROM_EMAIL=notifications@therailexchange.com

# ============================================================
# SMS - TWILIO (Optional)
# ============================================================
TWILIO_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1234567890

# ============================================================
# GOOGLE MAPS
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# ============================================================
# PUSHER (Real-time Messaging - Optional)
# ============================================================
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ============================================================
# ADMIN
# ============================================================
ADMIN_EMAIL=admin@therailexchange.com

# ============================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-...

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================================
# REDIS (Optional - for caching/rate limiting)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_REAL_TIME_MESSAGING=true
ENABLE_MAP_SEARCH=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_CONTRACTOR_MODULE=true
